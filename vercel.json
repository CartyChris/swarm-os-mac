{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no dependencies needed for the web build'",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/bridge.js": { "maxDuration": 300, "includeFiles": "bridge/swarm-bridge.mjs" }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/bridge?path=:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" }
      ]
    },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
